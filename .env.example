# This file lives at artist/.env, next to docker-compose.yml.
# It exists ONLY so Compose can resolve ${PUBLIC_BACKEND_URL} inside
# docker-compose.yml itself (the build.args line for the sveltekit service).
# It is not read by Django or by the running SvelteKit container —
# backend/.env and frontend/.env handle runtime env vars separately.

PUBLIC_BACKEND_URL